struct TwoSat {
    int n;
    vector<vector<int> > adj, adj_t;
    vector<int> order, comp;
    vector<bool> used, assignment;

    // Initialize for 'n' 0-indexed boolean variables
    TwoSat(int _n) : n(_n), adj(2 * n), adj_t(2 * n), comp(2 * n, -1), used(2 * n, false), assignment(n) {
    }

    // Maps variable 'i' and its desired boolean state to a unique node ID.
    // Node 2*i represents (X_i == false)
    // Node 2*i + 1 represents (X_i == true)
    inline int node(int i, bool is_true) {
        return 2 * i + is_true;
    }

    // Adds the directed edge representing: (u == u_val) => (v == v_val)
    void add_implication(int u, bool u_val, int v, bool v_val) {
        int from = node(u, u_val);
        int to = node(v, v_val);
        adj[from].push_back(to);
        adj_t[to].push_back(from);
    }

    // Adds the standard CNF clause: (u == u_val) OR (v == v_val)
    void add_clause(int u, bool u_val, int v, bool v_val) {
        // ~u => v
        add_implication(u, !u_val, v, v_val);
        // ~v => u
        add_implication(v, !v_val, u, u_val);
    }

    // Forces a variable to take a specific truth value
    void force_value(int u, bool u_val) {
        // ~u => u (If it is not the value, it implies it must be the value)
        add_implication(u, !u_val, u, u_val);
    }

    // Adds an XOR constraint: u ^ v == 1 (They must have different values)
    void add_xor(int u, int v) {
        add_clause(u, true, v, true); // u OR v
        add_clause(u, false, v, false); // ~u OR ~v
    }

    // Adds an XNOR constraint: u ^ v == 0 (They must have the same value)
    void add_xnor(int u, int v) {
        add_implication(u, true, v, true); // u => v
        add_implication(u, false, v, false); // ~u => ~v
        add_implication(v, true, u, true); // v => u
        add_implication(v, false, u, false); // ~v => ~u
    }

    void dfs1(int u) {
        used[u] = true;
        for (int v: adj[u]) {
            if (!used[v]) dfs1(v);
        }
        order.push_back(u);
    }

    void dfs2(int u, int id) {
        comp[u] = id;
        for (int v: adj_t[u]) {
            if (comp[v] == -1) dfs2(v, id);
        }
    }

    // Runs Kosaraju's SCC algorithm and assigns valid truth values.
    // Returns true if satisfiable, false otherwise.
    bool satisfiable() {
        order.clear();
        for (int i = 0; i < 2 * n; ++i) {
            if (!used[i]) dfs1(i);
        }

        int id = 0;
        // Process in reverse topological order of the DFS tree
        for (int i = 2 * n - 1; i >= 0; --i) {
            int u = order[i];
            if (comp[u] == -1) dfs2(u, id++);
        }

        for (int i = 0; i < n; ++i) {
            // If X and ~X belong to the same SCC, it's a contradiction
            if (comp[node(i, false)] == comp[node(i, true)]) {
                return false;
            }
            // Kosaraju assigns component IDs in topological order.
            assignment[i] = comp[node(i, true)] > comp[node(i, false)];
        }
        return true;
    }
};
