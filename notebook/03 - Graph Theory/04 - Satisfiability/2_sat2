struct PrefixTwoSat {
    int n; // Tracks the CURRENT total variables (Base + Dynamically added Prefixes)
    vector<vector<int>> adj, adj_t;
    vector<int> order, comp;
    vector<bool> used, assignment;

    // Initialize with the number of base variables.
    PrefixTwoSat(int base_n) : n(base_n), adj(2 * base_n), adj_t(2 * base_n) {}

    // Dynamically creates a new variable in the graph. Returns its index.
    int add_var() {
        int v = n++; // Assign ID, then increment total count
        adj.resize(2 * n);
        adj_t.resize(2 * n);
        return v;
    }

    inline int lit(int i, bool is_true) { return 2 * i + is_true; }
    inline int neg(int l) { return l ^ 1; }

    void add_impl_lit(int u_lit, int v_lit) {
        adj[u_lit].push_back(v_lit);
        adj_t[v_lit].push_back(u_lit);
        adj[neg(v_lit)].push_back(neg(u_lit));
        adj_t[neg(u_lit)].push_back(neg(v_lit));
    }

    void add_clause(int u, bool u_val, int v, bool v_val) { add_impl_lit(lit(u, !u_val), lit(v, v_val)); }

    // ---------------------------------------------------------
    // THE PREFIX TRICK (O(K) edges instead of O(K^2))
    // ---------------------------------------------------------
    // Takes an array of LITERALS. Forces that AT MOST ONE can be True.
    void at_most_one(const vector<int>& lits) {
        if (lits.size() <= 1) return; // 0 or 1 item trivially satisfies "at most one"

        int prev_prefix = -1;
        for (int cur_lit : lits) {
            // Create an auxiliary lightbulb (prefix) variable for this position
            int cur_prefix = lit(add_var(), true);

            // Rule 1: If I am chosen, my lightbulb turns ON.
            add_impl_lit(cur_lit, cur_prefix);

            if (prev_prefix != -1) {
                // Rule 2: If the lightbulb to my left is ON, my lightbulb turns ON.
                // (This carries the signal all the way to the right side of the array)
                add_impl_lit(prev_prefix, cur_prefix);

                // Rule 3 (The Kill Switch): If I am chosen, the lightbulb to my left MUST be OFF.
                // Because if it were ON, it would mean someone before me was already chosen!
                add_impl_lit(cur_lit, neg(prev_prefix));
            }
            prev_prefix = cur_prefix; // Step forward
        }
    }

    // Kosaraju Solver (Identical to classic)
    void dfs1(int u) {
        used[u] = true;
        for (int v : adj[u]) if (!used[v]) dfs1(v);
        order.push_back(u);
    }
    void dfs2(int u, int id) {
        comp[u] = id;
        for (int v : adj_t[u]) if (comp[v] == -1) dfs2(v, id);
    }
    bool satisfiable() {
        used.assign(2 * n, false);
        comp.assign(2 * n, -1);
        assignment.assign(n, false); // assignment array sizes to 'n' (base + prefix)
        order.clear();
        for (int i = 0; i < 2 * n; ++i) if (!used[i]) dfs1(i);
        int id = 0;
        for (int i = 2 * n - 1; i >= 0; --i) if (comp[order[i]] == -1) dfs2(order[i], id++);
        for (int i = 0; i < n; ++i) {
            if (comp[lit(i, false)] == comp[lit(i, true)]) return false;
            assignment[i] = comp[lit(i, true)] > comp[lit(i, false)];
        }
        return true; // Note: Only check the base variables (0 to base_n - 1) in your main code!
    }
};
