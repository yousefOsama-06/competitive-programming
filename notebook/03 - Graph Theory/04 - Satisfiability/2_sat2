struct SegTreeTwoSat {
    int n, base_n;
    vector<vector<int>> adj, adj_t;

    // We need TWO segment trees to avoid cyclic logic traps:
    // tree_in: Edges flow UP (Child => Parent). Used for "Range implies X"
    // tree_out: Edges flow DOWN (Parent => Child). Used for "X implies Range"
    vector<int> tree_in, tree_out;

    vector<int> order, comp;
    vector<bool> used, assignment;

    SegTreeTwoSat(int _base_n) : n(_base_n), base_n(_base_n), adj(2 * _base_n), adj_t(2 * _base_n) {
        tree_in.resize(4 * base_n);
        tree_out.resize(4 * base_n);
        if(base_n > 0) build(1, 0, base_n - 1);
    }

    int add_var() {
        int v = n++;
        adj.resize(2 * n);
        adj_t.resize(2 * n);
        return v;
    }

    inline int lit(int i, bool is_true) { return 2 * i + is_true; }
    inline int neg(int l) { return l ^ 1; }

    void add_impl_lit(int u_lit, int v_lit) {
        adj[u_lit].push_back(v_lit);
        adj_t[v_lit].push_back(u_lit);
        adj[neg(v_lit)].push_back(neg(u_lit));
        adj_t[neg(u_lit)].push_back(neg(v_lit));
    }

    void add_clause(int u, bool u_val, int v, bool v_val) { add_impl_lit(lit(u, !u_val), lit(v, v_val)); }

    // ---------------------------------------------------------
    // SEGMENT TREE BUILDER
    // ---------------------------------------------------------
    void build(int node, int l, int r) {
        if (l == r) {
            // Leaf nodes map directly to the actual base variables
            tree_in[node] = tree_out[node] = lit(l, true);
            return;
        }
        int mid = (l + r) / 2, lc = 2 * node, rc = 2 * node + 1;
        build(lc, l, mid);
        build(rc, mid + 1, r);

        // Every internal node gets its own dummy variable to represent the segment
        tree_in[node] = lit(add_var(), true);
        tree_out[node] = lit(add_var(), true);

        // Tree In (UP): If either child is True, the parent segment is True
        add_impl_lit(tree_in[lc], tree_in[node]);
        add_impl_lit(tree_in[rc], tree_in[node]);

        // Tree Out (DOWN): If the parent segment is True, BOTH children MUST be True
        add_impl_lit(tree_out[node], tree_out[lc]);
        add_impl_lit(tree_out[node], tree_out[rc]);
    }

    // ---------------------------------------------------------
    // RANGE QUERY (Internal)
    // ---------------------------------------------------------
    void _u_impl_range(int node, int tl, int tr, int l, int r, int u_lit) {
        if (l > r) return;
        // When we find a perfect segment match, link 'u' to the DOWN-flowing tree
        if (l == tl && r == tr) return add_impl_lit(u_lit, tree_out[node]);

        int tm = (tl + tr) / 2;
        _u_impl_range(node * 2, tl, tm, l, min(r, tm), u_lit);
        _u_impl_range(node * 2 + 1, tm + 1, tr, max(l, tm + 1), r, u_lit);
    }

    // Public API: "If literal u_lit is True, EVERY element from L to R must be True"
    // (This uses O(log N) edges instead of O(N) edges)
    void u_implies_range(int u_lit, int L, int R) {
        _u_impl_range(1, 0, base_n - 1, L, R, u_lit);
    }

    // Kosaraju Solver
    void dfs1(int u) {
        used[u] = true;
        for (int v : adj[u]) if (!used[v]) dfs1(v);
        order.push_back(u);
    }
    void dfs2(int u, int id) {
        comp[u] = id;
        for (int v : adj_t[u]) if (comp[v] == -1) dfs2(v, id);
    }
    bool satisfiable() {
        used.assign(2 * n, false);
        comp.assign(2 * n, -1);
        assignment.assign(n, false);
        order.clear();
        for (int i = 0; i < 2 * n; ++i) if (!used[i]) dfs1(i);
        int id = 0;
        for (int i = 2 * n - 1; i >= 0; --i) if (comp[order[i]] == -1) dfs2(order[i], id++);

        // Only check base variables for contradictions! Auxiliary variables are just logic pipes.
        for (int i = 0; i < base_n; ++i) {
            if (comp[lit(i, false)] == comp[lit(i, true)]) return false;
            assignment[i] = comp[lit(i, true)] > comp[lit(i, false)];
        }
        return true;
    }
};
